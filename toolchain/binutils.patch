From 60c2ac389505b00b421f1cf49ebe63dfe8e360e8 Mon Sep 17 00:00:00 2001
From: 0xsegf4ult <0xsegf4ult@protonmail.com>
Date: Sun, 26 Jul 2026 00:16:07 +0200
Subject: [PATCH] x86_64-monolith target

---
 bfd/config.bfd                       | 5 +++++
 config.sub                           | 3 ++-
 gas/configure.tgt                    | 1 +
 ld/Makefile.am                       | 2 ++
 ld/Makefile.in                       | 4 ++++
 ld/configure.tgt                     | 3 +++
 ld/emulparams/elf_i386_monolith.sh   | 4 ++++
 ld/emulparams/elf_x86_64_monolith.sh | 4 ++++
 8 files changed, 25 insertions(+), 1 deletion(-)
 create mode 100644 ld/emulparams/elf_i386_monolith.sh
 create mode 100644 ld/emulparams/elf_x86_64_monolith.sh

diff --git a/bfd/config.bfd b/bfd/config.bfd
index 4e5a838f..5aa7767e 100644
--- a/bfd/config.bfd
+++ b/bfd/config.bfd
@@ -721,6 +721,11 @@ case "${targ}" in
     want64=true
     targ_underscore=no
     ;;
+  x86_64-*-monolith*)
+    targ_defvec=x86_64_elf64_vec
+    targ_selvecs="i386_elf32_vec"
+    want64=true
+    ;;
   x86_64-*-rdos*)
     targ_defvec=x86_64_elf64_vec
     want64=true
diff --git a/config.sub b/config.sub
index 4aaae46f..23518745 100755
--- a/config.sub
+++ b/config.sub
@@ -2046,7 +2046,8 @@ case $os in
 	| mlibc* \
 	| mmixware* \
 	| mon960* \
-	| morphos* \
+	| monolith* \
+        | morphos* \
 	| moss* \
 	| moxiebox* \
 	| mpeix* \
diff --git a/gas/configure.tgt b/gas/configure.tgt
index 7c81bffa..04d2d77c 100644
--- a/gas/configure.tgt
+++ b/gas/configure.tgt
@@ -235,6 +235,7 @@ case ${generic_target} in
   i386-*-bsd*)				fmt=aout em=386bsd ;;
   i386-*-netbsd*-gnu* | \
   i386-*-knetbsd*-gnu | \
+  i386-*-monolith*)			fmt=elf ;;
   i386-*-netbsd* | \
   i386-*-openbsd*)			fmt=elf em=nbsd ;;
   i386-*-linux-*)			fmt=elf em=linux
diff --git a/ld/Makefile.am b/ld/Makefile.am
index ccff9289..972d37a7 100644
--- a/ld/Makefile.am
+++ b/ld/Makefile.am
@@ -281,6 +281,7 @@ ALL_EMULATION_SOURCES = \
 	eelf_i386_fbsd.c \
 	eelf_i386_haiku.c \
 	eelf_i386_ldso.c \
+	eelf_i386_monolith.c \
 	eelf_i386_sol2.c \
 	eelf_i386_vxworks.c \
 	eelf_iamcu.c \
@@ -462,6 +463,7 @@ ALL_64_EMULATION_SOURCES = \
 	eelf_x86_64_cloudabi.c \
 	eelf_x86_64_fbsd.c \
 	eelf_x86_64_haiku.c \
+	eelf_x86_64_monolith.c \
 	eelf_x86_64_sol2.c \
 	ehppa64linux.c \
 	ei386pep.c \
diff --git a/ld/Makefile.in b/ld/Makefile.in
index 3e24bd4d..b4a42439 100644
--- a/ld/Makefile.in
+++ b/ld/Makefile.in
@@ -792,6 +792,7 @@ ALL_EMULATION_SOURCES = \
 	eelf_i386_fbsd.c \
 	eelf_i386_haiku.c \
 	eelf_i386_ldso.c \
+	eelf_i386_monolith.c \
 	eelf_i386_sol2.c \
 	eelf_i386_vxworks.c \
 	eelf_iamcu.c \
@@ -972,6 +973,7 @@ ALL_64_EMULATION_SOURCES = \
 	eelf_x86_64_cloudabi.c \
 	eelf_x86_64_fbsd.c \
 	eelf_x86_64_haiku.c \
+	eelf_x86_64_monolith.c \
 	eelf_x86_64_sol2.c \
 	ehppa64linux.c \
 	ei386pep.c \
@@ -1480,6 +1482,7 @@ distclean-compile:
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_fbsd.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_haiku.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_ldso.Po@am__quote@
+@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_monolith.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_sol2.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_vxworks.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_iamcu.Po@am__quote@
@@ -1489,6 +1492,7 @@ distclean-compile:
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_x86_64_cloudabi.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_x86_64_fbsd.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_x86_64_haiku.Po@am__quote@
+@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_x86_64_monolith.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_x86_64_sol2.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eh8300elf.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eh8300elf_linux.Po@am__quote@
diff --git a/ld/configure.tgt b/ld/configure.tgt
index ea01ccf9..9c51144b 100644
--- a/ld/configure.tgt
+++ b/ld/configure.tgt
@@ -1016,6 +1016,9 @@ x86_64-*-linux-*)	targ_emul=elf_x86_64
 			targ_extra_libpath="elf_i386 elf32_x86_64"
 			tdir_elf_i386=`echo ${targ_alias} | sed -e 's/x86_64/i386/'`
 			;;
+x86_64-*-monolith*)	targ_emul=elf_x86_64_monolith
+			targ_extra_emuls="elf_i386_monolith elf_x86_64 elf_i386"
+			;;
 x86_64-*-redox*)	targ_emul=elf_x86_64
 			targ_extra_emuls=elf_i386
 			;;
diff --git a/ld/emulparams/elf_i386_monolith.sh b/ld/emulparams/elf_i386_monolith.sh
new file mode 100644
index 00000000..802faab0
--- /dev/null
+++ b/ld/emulparams/elf_i386_monolith.sh
@@ -0,0 +1,4 @@
+source ${srcdir}/emulparams/elf_i386.sh
+TEXT_START_ADDR=0x08048000
+GENERATE_SHLIB_SCRIPT=yes
+GENERATE_PIE_SCRIP=yes
diff --git a/ld/emulparams/elf_x86_64_monolith.sh b/ld/emulparams/elf_x86_64_monolith.sh
new file mode 100644
index 00000000..937efc54
--- /dev/null
+++ b/ld/emulparams/elf_x86_64_monolith.sh
@@ -0,0 +1,4 @@
+source ${srcdir}/emulparams/elf_x86_64.sh
+TEXT_START_ADDR=0x400000
+GENERATE_SHLIB_SCRIPT=yes
+GENERATE_PIE_SCRIPT=yes
