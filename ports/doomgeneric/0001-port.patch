diff --git a/doomgeneric/Makefile.monolith b/doomgeneric/Makefile.monolith
new file mode 100644
index 0000000..5bfab21
--- /dev/null
+++ b/doomgeneric/Makefile.monolith
@@ -0,0 +1,55 @@
+################################################################
+#
+# $Id:$
+#
+# $Log:$
+#
+
+ifeq ($(V),1)
+	VB=''
+else
+	VB=@
+endif
+
+
+CC=x86_64-monolith-gcc  # gcc or g++
+LD=x86_64-monolith-ld
+CFLAGS+=-ggdb3 -Os
+LDFLAGS+=-Wl,--gc-sections
+CFLAGS+=-ggdb3 -Wall -DNORMALUNIX -D_DEFAULT_SOURCE # -DUSEASM
+LIBS+=-lm -lc
+
+# subdirectory for objects
+OBJDIR=build
+OUTPUT=doomgeneric
+
+SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o i_video.o doomgeneric.o doomgeneric_monolith.o
+OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))
+
+all:	 $(OUTPUT)
+
+clean:
+	rm -rf $(OBJDIR)
+	rm -f $(OUTPUT)
+	rm -f $(OUTPUT).gdb
+	rm -f $(OUTPUT).map
+
+$(OUTPUT):	$(OBJS)
+	@echo [Linking $@]
+	$(VB)$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) \
+	-o $(OUTPUT) $(LIBS) -Wl,-Map,$(OUTPUT).map
+	@echo [Size]
+	-$(CROSS_COMPILE)size $(OUTPUT)
+
+$(OBJS): | $(OBJDIR)
+
+$(OBJDIR):
+	mkdir -p $(OBJDIR)
+
+$(OBJDIR)/%.o:	%.c
+	@echo [Compiling $<]
+	$(VB)$(CC) $(CFLAGS) -c $< -o $@
+
+print:
+	@echo OBJS: $(OBJS)
+
diff --git a/doomgeneric/doomgeneric_monolith.c b/doomgeneric/doomgeneric_monolith.c
new file mode 100644
index 0000000..49ea295
--- /dev/null
+++ b/doomgeneric/doomgeneric_monolith.c
@@ -0,0 +1,209 @@
+#include "doomkeys.h"
+#include "m_argv.h"
+#include "doomgeneric.h"
+#include "i_system.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <sys/ioctl.h>
+#include <sys/framebuffer.h>
+
+#include <stdbool.h>
+
+static struct timespec startTime;
+
+static uint8_t *fbPtr;
+static int fbFd;
+static unsigned int fbWidth, fbHeight, fbStride, fbBytesPerPixel, fbOffsetX, fbOffsetY;
+static int kbdFd;
+
+#define KEYQUEUE_SIZE 16
+static unsigned short s_KeyQueue[KEYQUEUE_SIZE];
+static unsigned int s_KeyQueueWriteIndex = 0;
+static unsigned int s_KeyQueueReadIndex = 0;
+
+struct key_event
+{
+	char key;
+	bool state;
+};
+
+static unsigned char convertToDoomKey(char key) {
+
+	switch(key)
+	{
+	case '\n':
+		return KEY_ENTER;
+	case '\t':
+		return KEY_TAB;
+	case ' ':
+		return KEY_USE;
+	case 0x7f:
+		return KEY_BACKSPACE;
+	case 0x1b:
+		return KEY_ESCAPE;
+	case 0x1d:
+		return KEY_FIRE;
+	case 'w':
+	case 'W':
+		return KEY_UPARROW;
+	case 's':
+	case 'S':
+		return KEY_DOWNARROW;
+	case 'a':
+	case 'A':
+		return KEY_LEFTARROW;
+	case 'D':
+	case 'd':
+		return KEY_RIGHTARROW;
+	}
+
+	return tolower(key);	
+}
+
+static void addKeyToQueue(bool pressed, char key) {
+	unsigned char dkey = convertToDoomKey(key);
+
+	if(dkey == 0xFF)
+		return;
+
+	unsigned short keyData = (pressed << 8) | dkey;
+
+	s_KeyQueue[s_KeyQueueWriteIndex] = keyData;
+	s_KeyQueueWriteIndex++;
+	s_KeyQueueWriteIndex %= KEYQUEUE_SIZE;
+}
+
+static void checkKeys() {
+	bool advance = true;
+	while(advance)
+	{
+		advance = false;
+
+		struct key_event ev;
+		ssize_t ret = read(kbdFd, &ev, sizeof(struct key_event));
+	       	if(ret < 0)
+			I_Error("Error while reading from keyboard: %s", strerror(errno));
+
+		if(ret)
+		{
+			advance = true;
+			addKeyToQueue(ev.state, ev.key);
+		}
+	}
+}
+				
+void DG_Init() {
+	int ret;
+	fbinfo_t finfo;
+
+	fbFd = open("/dev/fb0", 0);
+	if (fbFd < 0)
+		I_Error("Failed to open /dev/fb0: %s", strerror(errno));
+
+	ret = ioctl(fbFd, FBIOCGETINFO, &finfo);
+	if (ret != 0)
+		I_Error("Failed to get framebuffer info: %s", strerror(errno));
+
+	ret = ioctl(fbFd, FBIOCSETGFX, 0);
+	if(ret < 0)
+		I_Error("Failed to set framebuffer to GFX mode: %s", strerror(errno));
+
+	fbWidth = finfo.width;
+	fbHeight = finfo.height;
+	fbBytesPerPixel = finfo.bpp;
+	fbStride = finfo.pitch;
+
+	// to center the image on screen
+	fbOffsetX = ((fbWidth - DOOMGENERIC_RESX) / 2) * fbBytesPerPixel;
+	fbOffsetY = ((fbHeight - DOOMGENERIC_RESY) / 2) * fbStride;
+
+	fbPtr = mmap(NULL, fbStride * fbHeight, PROT_READ | PROT_WRITE,
+			MAP_SHARED, fbFd, 0);
+
+	if (!fbPtr)
+		I_Error("Failed to mmap /dev/fb0");
+
+	// clear the screen
+	memset(fbPtr, 0, fbStride * fbHeight);
+
+	kbdFd = open("/dev/keyboard", 0);
+	if(kbdFd < 0)
+		I_Error("Failed to open keyboard: %s", strerror(errno));
+
+	// get the start time
+	clock_gettime(CLOCK_REALTIME, &startTime);
+}
+
+void DG_DrawFrame() {
+	// we need to do it line-by-line like this to account for the
+	// fact that the system framebuffer resolution is very likely
+	// larger than the doomgeneric render resolution.
+	for (int line = 0; line < DOOMGENERIC_RESY; line++) {
+		memcpy(
+			(void *)((uintptr_t)(fbPtr) + (fbStride * line) + fbOffsetY + fbOffsetX),
+				(void *)(((uintptr_t)DG_ScreenBuffer) + (DOOMGENERIC_RESX * line * fbBytesPerPixel)),
+			 (fbBytesPerPixel * DOOMGENERIC_RESX)
+		);
+	}
+
+	checkKeys();
+}
+
+void DG_SleepMs(uint32_t ms) {
+	struct timespec sleep_tv;
+	sleep_tv.tv_sec = 0;
+	sleep_tv.tv_nsec = ms * 1000000;
+	clock_nanosleep(CLOCK_REALTIME, 0, &sleep_tv, NULL);
+}
+
+uint32_t DG_GetTicksMs() {
+	struct timespec curTime;
+	long seconds, nsec;
+
+	clock_gettime(CLOCK_REALTIME, &curTime);
+	
+	seconds = curTime.tv_sec - startTime.tv_sec;
+	nsec = curTime.tv_nsec - startTime.tv_nsec;
+
+	return (seconds * 1000) + (nsec / 1000000);
+}
+
+int DG_GetKey(int* pressed, unsigned char* doomKey) {
+	checkKeys();
+
+	if(s_KeyQueueReadIndex == s_KeyQueueWriteIndex) {
+		return 0;
+	}
+	else {
+		unsigned short keyData = s_KeyQueue[s_KeyQueueReadIndex];
+		s_KeyQueueReadIndex++;
+		s_KeyQueueReadIndex %= KEYQUEUE_SIZE;
+
+		*pressed = keyData >> 8;
+		*doomKey = keyData & 0xFF;
+		return 1;
+	}
+}
+
+void DG_SetWindowTitle(const char * title) {
+	printf("Window Title: %s\n", title);
+}
+
+int main(int argc, char **argv) {
+	doomgeneric_Create(argc, argv);
+
+	while (1)
+	{
+		doomgeneric_Tick();
+	}
+
+
+	return 0;
+}
